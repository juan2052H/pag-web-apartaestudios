# Copia este archivo a ".env" y completa los valores.
# Sin esto, la recuperación de contraseña por correo sigue "funcionando" en
# modo degradado: el código se imprime en la consola del servidor en vez de
# enviarse (útil para desarrollo local).

# API key de tu cuenta en https://resend.com (empieza con "re_").
RESEND_API_KEY=

# Remitente verificado en Resend (necesitas verificar un dominio propio para
# poder enviar a cualquier destinatario; sin dominio verificado, Resend solo
# deja enviar de prueba a tu propio correo de la cuenta).
RESEND_FROM=
